# Backend Node server (optional)
PORT=3001
# Comma-separated list of websites allowed to open a WebSocket, e.g. https://your-game.vercel.app
ALLOWED_ORIGINS=
# Max simultaneous sockets per IP (each Multi player uses 2)
MAX_CONN_PER_IP=8
# Set to 1 only when running behind a trusted reverse proxy (Render/Railway) so X-Forwarded-For is used
TRUST_PROXY=0

# OAuth: exact origins, no trailing slash. Prefer game.example.com + api.example.com.
PUBLIC_ORIGIN=https://api.your-domain.com
FRONTEND_ORIGIN=https://your-domain.com
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Set the supported version displayed in your Meta developer application, e.g. vXX.0
FACEBOOK_GRAPH_VERSION=
